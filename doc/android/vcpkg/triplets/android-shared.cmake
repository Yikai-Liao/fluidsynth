# Build the same shared-library dependency set for all four Android ABIs.
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE dynamic)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CMAKE_SYSTEM_NAME Android)
set(VCPKG_CMAKE_SYSTEM_VERSION 24)
if(DEFINED ENV{ANDROID_API})
    set(VCPKG_CMAKE_SYSTEM_VERSION "$ENV{ANDROID_API}")
endif()
set(VCPKG_ENV_PASSTHROUGH ANDROID_API)
set(VCPKG_LINKER_FLAGS "-Wl,-z,max-page-size=16384")
list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON)
