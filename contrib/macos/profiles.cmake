cmake_minimum_required(VERSION 3.13)

# Initialize the same native configurations in local builds and CI.
set(profiles unix-shared unix-static unix-static-readline framework framework-10.14 ports-universal)
if(NOT FLUIDSYNTH_MACOS_PROFILE IN_LIST profiles)
    message(FATAL_ERROR "Unknown macOS profile: ${FLUIDSYNTH_MACOS_PROFILE}")
endif()
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "" FORCE)
set(enable-framework OFF CACHE BOOL "" FORCE)
if(FLUIDSYNTH_MACOS_PROFILE MATCHES "^unix-static")
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
elseif(FLUIDSYNTH_MACOS_PROFILE MATCHES "^framework")
    set(enable-framework ON CACHE BOOL "" FORCE)
    if(FLUIDSYNTH_MACOS_PROFILE STREQUAL "framework-10.14")
        set(CMAKE_OSX_DEPLOYMENT_TARGET 10.14 CACHE STRING "" FORCE)
    endif()
elseif(FLUIDSYNTH_MACOS_PROFILE STREQUAL "ports-universal")
    set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "" FORCE)
    set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64" CACHE STRING "" FORCE)
    set(enable-sdl3 OFF CACHE BOOL "" FORCE)
endif()
