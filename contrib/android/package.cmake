file(READ "${PREFIX}/../build/fluidsynth/config.h" fluid_config)
foreach(feature OBOE_SUPPORT OPENSLES_SUPPORT LIBSNDFILE_SUPPORT LIBSNDFILE_HASVORBIS)
    if(NOT fluid_config MATCHES "#define ${feature} 1")
        message(FATAL_ERROR "Required Android feature was not enabled: ${feature}")
    endif()
endforeach()

set(triples_armeabi-v7a arm-linux-androideabi)
set(triples_arm64-v8a aarch64-linux-android)
set(triples_x86 i686-linux-android)
set(triples_x86_64 x86_64-linux-android)
file(GLOB runtimes "${NDK}/toolchains/llvm/prebuilt/*/sysroot/usr/lib/${triples_${ABI}}/libc++_shared.so")
list(LENGTH runtimes runtime_count)
if(NOT runtime_count EQUAL 1)
    message(FATAL_ERROR "Expected one NDK libc++_shared.so for ${ABI}, found ${runtime_count}")
endif()
file(COPY ${runtimes} DESTINATION "${PREFIX}/lib")

# Copy real files so the package can be used directly as a jniLibs directory.
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}/lib/${ABI}")
foreach(library FLAC fluidsynth-assetloader fluidsynth oboe ogg opus sndfile vorbis vorbisenc vorbisfile c++_shared)
    set(source "${PREFIX}/lib/lib${library}.so")
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Missing Android library: ${source}")
    endif()
    file(REAL_PATH "${source}" real_source)
    set(packaged_library "${OUTPUT}/lib/${ABI}/lib${library}.so")
    configure_file("${real_source}" "${packaged_library}" COPYONLY)
    # The NDK's 32-bit C++ runtime uses 4 KB pages; 16 KB devices use 64-bit ABIs.
    if(NOT library STREQUAL "c++_shared" OR ABI MATCHES "^(arm64-v8a|x86_64)$")
        execute_process(COMMAND bash "${CMAKE_CURRENT_LIST_DIR}/../check_elf_alignment.sh" "${packaged_library}"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endforeach()
file(COPY "${PREFIX}/include/fluidsynth.h" "${PREFIX}/include/fluidsynth" DESTINATION "${OUTPUT}/include")
